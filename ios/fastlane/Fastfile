default_platform(:ios)

APP_ID = "ro.climbagain.mycoffee"
APP_NAME = "MyCoffee"
PROJECT = "MyCoffee.xcodeproj"
SCHEME = "MyCoffee"

platform :ios do
  desc "Build MyCoffee and upload to TestFlight"
  lane :beta do
    # 1. Ephemeral keychain for this CI run.
    keychain_name = "mycoffee_ci.keychain"
    keychain_password = SecureRandom.uuid
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 21_600,
      lock_when_sleeps: false
    )

    # 2. App Store Connect API key (from GH secrets).
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false
    )

    # 3. Fetch/import distribution cert + provisioning profile via match.
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      team_id: ENV["DEVELOPMENT_TEAM"],
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    # 3b. Mirror the matched profile into the LEGACY provisioning-profiles dir.
    #
    # match 2.237.0 installs the profile into the Xcode 16+ location
    # (~/Library/Developer/Xcode/UserData/Provisioning Profiles/), but a
    # command-line `xcodebuild archive` resolving PROVISIONING_PROFILE_SPECIFIER by
    # name still scans the legacy ~/Library/MobileDevice/Provisioning Profiles/.
    # With the profile only in the new dir, the archive fails with "No profile for
    # team '...' matching 'match AppStore ro.climbagain.mycoffee' found" even though
    # match installed it correctly (runs #8 and #10 both died here). Copy it into
    # the legacy dir under its UUID so xcodebuild finds it by name wherever it looks.
    installed_profile = ENV["sigh_#{APP_ID}_appstore_profile-path"]
    profile_uuid      = ENV["sigh_#{APP_ID}_appstore"]
    if installed_profile && profile_uuid && File.exist?(installed_profile)
      legacy_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
      FileUtils.mkdir_p(legacy_dir)
      FileUtils.cp(installed_profile, File.join(legacy_dir, "#{profile_uuid}.mobileprovision"))
      UI.message("Mirrored profile #{profile_uuid} into #{legacy_dir}")
    else
      UI.important("Could not locate installed profile to mirror (path=#{installed_profile.inspect})")
    end

    # 4. Generate the Xcode project from project.yml.
    #
    # fastlane's `sh` runs with the working directory set to the Fastfile's own
    # folder (ios/fastlane), but the XcodeGen spec lives one level up at
    # ios/project.yml -- so a bare `sh("xcodegen","generate")` fails with
    # "No project spec found at .../ios/fastlane/project.yml". Run it from ios/,
    # which is also where build_app expects MyCoffee.xcodeproj to appear and where
    # the workflow's compile-check step generates it.
    Dir.chdir("..") do
      sh("xcodegen", "generate")
    end

    # 5. Force manual signing with the matched profile.
    profile_name = ENV["sigh_#{APP_ID}_appstore_profile-name"] ||
                   "match AppStore #{APP_ID}"
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID,
      targets: [APP_NAME]
    )

    # 6. Build number = minute timestamp (monotonic, TestFlight-friendly).
    build_number = Time.now.strftime("%Y%m%d%H%M")

    # 7. Build the archive.
    #
    # Manual signing must be handed to BOTH xcodebuild steps explicitly, or the
    # archive fails with "No profile for team '...' matching 'match AppStore
    # ro.climbagain.mycoffee' found" (run #8). update_code_signing_settings writes
    # the profile into the .pbxproj, but an XcodeGen-regenerated project doesn't
    # reliably carry it into the archive invocation, so:
    #   - xcargs pins CODE_SIGN_STYLE / DEVELOPMENT_TEAM / PROVISIONING_PROFILE_SPECIFIER
    #     / CODE_SIGN_IDENTITY onto the ARCHIVE step, and
    #   - export_options.provisioningProfiles maps the bundle id → profile for the
    #     EXPORT step.
    # profile_name comes from match's own sigh_* env var, so it always matches the
    # profile match just installed.
    #
    # TEAM: derive it from the profile match actually installed (sigh_*_team-id),
    # NOT from the DEVELOPMENT_TEAM secret. This was the real cause of runs #8-#12:
    # the profile was installed, valid, and correctly named, yet the archive kept
    # failing with "No profile for team '<TEAM>/match AppStore ...' found". match
    # resolves the team from the ASC API key (PH2NNQ47UB) and stamps the profile
    # with it, but the archive was searching under ENV["DEVELOPMENT_TEAM"]; those
    # two diverged, so nothing matched. Deriving the team from the profile match
    # installed guarantees the archive searches under the same team. (See CLAUDE.md
    # §12 for the TTR9KS5493->PH2NNQ47UB and whitespace-in-env footguns that make
    # the DEVELOPMENT_TEAM secret an unreliable source here.)
    team_id = ENV["sigh_#{APP_ID}_appstore_team-id"] || ENV["DEVELOPMENT_TEAM"]
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{team_id}",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
      ].join(" "),
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { APP_ID => profile_name },
      }
    )

    # 8. Upload to TestFlight (no external distribution, no waiting on processing).
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
