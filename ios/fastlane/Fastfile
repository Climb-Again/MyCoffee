default_platform(:ios)

APP_ID = "ro.climbagain.mycoffee"
APP_NAME = "MyCoffee"
PROJECT = "MyCoffee.xcodeproj"
SCHEME = "MyCoffee"

platform :ios do
  desc "Build MyCoffee and upload to TestFlight"
  lane :beta do
    # 1. Ephemeral keychain for this CI run.
    keychain_name = "mycoffee_ci.keychain"
    keychain_password = SecureRandom.uuid
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 21_600,
      lock_when_sleeps: false
    )

    # 2. App Store Connect API key (from GH secrets).
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false
    )

    # 3. Fetch/import distribution cert + provisioning profile via match.
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      team_id: ENV["DEVELOPMENT_TEAM"],
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    # 4. Generate the Xcode project from project.yml.
    sh("xcodegen", "generate")

    # 5. Force manual signing with the matched profile.
    profile_name = ENV["sigh_#{APP_ID}_appstore_profile-name"] ||
                   "match AppStore #{APP_ID}"
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID,
      targets: [APP_NAME]
    )

    # 6. Build number = minute timestamp (monotonic, TestFlight-friendly).
    build_number = Time.now.strftime("%Y%m%d%H%M")

    # 7. Build the archive.
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: { signingStyle: "manual" }
    )

    # 8. Upload to TestFlight (no external distribution, no waiting on processing).
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
