# MyCoffee backend — environment variables
# Copy to `.env` for local dev. NEVER commit real secrets.
# On Railway, set these in the service settings (DATABASE_URL + PORT are auto-provided).

# --- Core ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Required in production. Hard-exits if missing. Auto-provided by the Railway Postgres plugin.
DATABASE_URL=postgres://user:pass@localhost:5432/mycoffee
# Set to "disable" to turn off TLS on the pg connection (implied for localhost).
PGSSL=

# --- Auth tokens (generate with: openssl rand -hex 32) ---
# iOS app sends this on writes.
INGEST_TOKEN=
# Read endpoints.
APP_TOKEN=

# --- Storage ---
# Volume mount point on Railway.
DATA_DIR=/data
MAX_UPLOAD_BYTES=104857600

# --- Rate limiting ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- Google Cloud / Vertex AI (reused from MyHealthOS — same GCP project + SA) ---
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Tolerant: full service-account JSON (leading "{"), raw PEM, base64, or escaped-newline form.
GOOGLE_PRIVATE_KEY=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_CLIENT_ID=
VERTEX_AI_REGION=us-central1
# Optional; defaults to gemini-2.5-pro.
VERTEX_MODEL=gemini-2.5-pro
