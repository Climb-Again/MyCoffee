{
  "manifest_version": 3,
  "name": "MyCoffee — Evaluate",
  "description": "Score a coffee against your own tasted library while browsing a roaster's shop.",
  "version": "1.3.0",
  "action": {
    "default_title": "Evaluate this coffee",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://mycoffee-production-bd43.up.railway.app/*",
    "https://raw.githubusercontent.com/Climb-Again/MyCoffee/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
